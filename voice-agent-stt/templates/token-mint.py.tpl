"""Short-lived access token endpoint.

Generated by the `voice-agent-stt` skill. Add this to the customer's backend so a
browser or mobile client never holds the permanent API key.

The client calls this, gets a `wat_` token, and uses it on the STT WebSocket.
Tokens expire, so the client mints a fresh one whenever it reconnects.

Requires: requests, plus whatever web framework the app already uses. The
FastAPI wiring below is an example; the mint() function is the part that matters.
"""

from __future__ import annotations

import os

import requests

# Must be the same host the client will connect to: a token is only valid in the
# region that minted it.
SMALLEST_HOST = "{{host}}"
TOKEN_TTL_SECONDS = 300  # 30 to 900, default 300


def mint_stt_token(ttl_seconds: int = TOKEN_TTL_SECONDS) -> dict:
    """Mint a short-lived token from the permanent API key. Server-side only."""
    api_key = os.environ["SMALLEST_API_KEY"]
    r = requests.post(
        f"https://{SMALLEST_HOST}/waves/v1/auth/token",
        json={"ttl_seconds": ttl_seconds},
        headers={"Authorization": f"Bearer {api_key}"},
        timeout=10,
    )
    r.raise_for_status()
    # {"access_token": "wat_...", "token_type": "Bearer",
    #  "expires_in": 300, "expires_at": "2026-09-29T13:01:14.533Z"}
    return r.json()


