/**
 * Short-lived access token endpoint.
 *
 * Generated by the `smallest-stt` skill. Add this to the customer's backend so a
 * browser or mobile client never holds the permanent API key.
 *
 * The client calls this, gets a `wat_` token, and uses it on the STT WebSocket.
 * Tokens expire, so the client mints a fresh one whenever it reconnects.
 */

// Must be the same host the client will connect to: a token is only valid in the
// region that minted it.
const SMALLEST_HOST = "{{host}}";
const TOKEN_TTL_SECONDS = 300; // 30 to 900, default 300

export interface AccessToken {
  access_token: string;
  token_type: "Bearer";
  expires_in: number;
  expires_at: string;
}

/** Mint a short-lived token from the permanent API key. Server-side only. */
export async function mintSttToken(ttlSeconds = TOKEN_TTL_SECONDS): Promise<AccessToken> {
  const apiKey = process.env.SMALLEST_API_KEY;
  if (!apiKey) throw new Error("SMALLEST_API_KEY is not set");

  const res = await fetch(`https://${SMALLEST_HOST}/waves/v1/auth/token`, {
    method: "POST",
    headers: { Authorization: `Bearer ${apiKey}`, "Content-Type": "application/json" },
    body: JSON.stringify({ ttl_seconds: ttlSeconds }),
  });
  if (!res.ok) throw new Error(`mint failed: ${res.status} ${await res.text()}`);
  return (await res.json()) as AccessToken;
}

