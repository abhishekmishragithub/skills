"""Smallest AI streaming STT client.

Generated by the `smallest-stt` skill. Turn rules, and why each one is here:
  - Commit on any is_final carrying text, including is_last. When the stream is
    closed with speech still buffered, the last utterance arrives on is_last.
  - Ignore is_final messages with an empty transcript. They are normal.
  - speech_started stops TTS (barge-in) and nothing else.
  - finalize is edge-triggered, once per turn, and only after at least 300 ms of
    audio has been streamed past the end of speech.

Requires: websockets 14 or newer. Earlier releases have no `additional_headers`
keyword on `connect`, and no `ClientConnection` type.
"""

from __future__ import annotations

import asyncio
import json
import logging
import os
import time
from dataclasses import dataclass, field
from typing import Awaitable, Callable
from urllib.parse import urlencode

import websockets

HOST = "{{host}}"  # api.smallest.ai, api.us.smallest.ai, or api.india.smallest.ai
STT_URL = f"wss://{HOST}/waves/v1/stt/live"
API_KEY_ENV = "SMALLEST_API_KEY"

STT_PARAMS = {
    "model": "pulse",
    "language": "{{language}}",
    "sample_rate": "{{sample_rate}}",
    "encoding": "{{encoding}}",
    "format": "true",
    "punctuate": "true",
    "capitalize": "true",
    "itn_normalize": "{{itn_normalize}}",
    "endpointing": "true",
    "finalize_on_words": "false",
    "vad_events": "true",
    # eou_timeout_ms is deliberately not set. Lowering it does not commit turns
    # faster, and below 500 the server finalizes mid-word.
}
KEYWORDS = "{{keywords}}"

# `finalize()` holds the request back this long so audio keeps flowing past the
# end of speech. Finalizing the instant a VAD fires truncates the last word.
FINALIZE_TRAILING_MS = 300
KEEPALIVE_IDLE_S = 20

log = logging.getLogger("smallest_stt")


@dataclass
class TurnMetrics:
    speech_started_ms: int | None = None
    speech_ended_ms: int | None = None
    first_partial_ms: int | None = None
    finalize_sent_ms: int | None = None
    empty_finals: int = 0


@dataclass
class SttSession:
    """One WebSocket per call. Reconnecting per turn costs more than holding it open."""

    on_speech_started: Callable[[], Awaitable[None]]   # stop TTS (barge-in)
    on_final_commit: Callable[[str], Awaitable[None]]  # send to the LLM
    # Called when the server asks us to leave before a deploy. Finish the turn,
    # then reconnect. If you pass nothing, the session just logs and closes.
    on_server_shutdown: Callable[[], Awaitable[None]] | None = None
    external_session_id: str = ""                      # your own call id, for support

    _ws: websockets.ClientConnection | None = None
    _recv_task: asyncio.Task | None = None
    _keepalive_task: asyncio.Task | None = None
    _start: float = field(default_factory=time.monotonic)
    _last_audio_ms: int = 0
    _m: TurnMetrics = field(default_factory=TurnMetrics)

    def _now(self) -> int:
        return int((time.monotonic() - self._start) * 1000)

    async def connect(self) -> None:
        api_key = os.environ.get(API_KEY_ENV)
        if not api_key:
            raise RuntimeError(f"{API_KEY_ENV} is not set")
        params = dict(STT_PARAMS)
        if KEYWORDS:
            params["keywords"] = KEYWORDS
        if self.external_session_id:
            params["external_session_id"] = self.external_session_id
        url = f"{STT_URL}?{urlencode(params)}"
        self._ws = await websockets.connect(
            url,
            additional_headers=[("Authorization", f"Bearer {api_key}")],
            max_size=10 * 1024 * 1024,
            open_timeout=20,
        )
        log.info("stt.connected", extra={"host": HOST})
        self._recv_task = asyncio.create_task(self._recv_loop())
        self._keepalive_task = asyncio.create_task(self._keepalive_loop())

    async def send_audio(self, pcm: bytes) -> None:
        """Send one 20 to 40 ms chunk of raw PCM. No base64."""
        if self._ws is None:
            return
        self._last_audio_ms = self._now()
        await self._ws.send(pcm)

    async def finalize(self) -> None:
        """Call once per turn, the moment your own VAD or dialog logic is certain
        the caller is done.

        Keep calling send_audio while this is awaited. It deliberately waits
        FINALIZE_TRAILING_MS before sending, because finalizing with less than
        about 300 ms of audio past the end of speech truncates the last word.
        """
        if self._ws is None:
            return
        requested_at = self._now()
        await asyncio.sleep(FINALIZE_TRAILING_MS / 1000)
        if self._ws is None:
            return
        if self._last_audio_ms <= requested_at:
            # No audio arrived during the window, so the buffer may still be
            # short of the last word. Keep streaming through your VAD stop.
            log.warning(
                "stt.finalize_without_trailing_audio",
                extra={"silent_ms": self._now() - self._last_audio_ms},
            )
        self._m.finalize_sent_ms = self._now()
        await self._ws.send(json.dumps({"type": "finalize"}))

    async def close(self) -> None:
        """Ask the server to flush, then wait for is_last before dropping the socket."""
        if self._ws is None:
            return
        try:
            await self._ws.send(json.dumps({"type": "close_stream"}))
            if self._recv_task:
                await asyncio.wait_for(self._recv_task, timeout=5)
        except (asyncio.TimeoutError, websockets.ConnectionClosed):
            pass
        finally:
            if self._keepalive_task:
                self._keepalive_task.cancel()
            await self._ws.close()
            self._ws = None

    async def _keepalive_loop(self) -> None:
        while self._ws is not None:
            await asyncio.sleep(KEEPALIVE_IDLE_S)
            if self._ws is not None and self._now() - self._last_audio_ms > KEEPALIVE_IDLE_S * 1000:
                try:
                    await self._ws.send(json.dumps({"type": "ping"}))
                except websockets.ConnectionClosed:
                    return

    async def _recv_loop(self) -> None:
        assert self._ws is not None
        try:
            async for msg in self._ws:
                if not isinstance(msg, str):
                    continue
                try:
                    payload = json.loads(msg)
                except ValueError:
                    continue
                if await self._handle(payload):
                    return
        except websockets.ConnectionClosed:
            return

    async def _handle(self, p: dict) -> bool:
        """Returns True when the stream is finished."""
        now = self._now()
        kind = p.get("type")

        # Errors arrive after a successful upgrade, not as an HTTP status.
        if kind == "error" or p.get("status") == "error":
            log.error("stt.error", extra={"payload": p})
            return True

        if kind == "pong":
            return False

        # Sent about a minute before a deploy closes this socket with code 1012.
        # Carries status "info", not an error, so it must be handled separately.
        if kind == "server_shutdown":
            log.warning("stt.server_shutdown", extra={"deadline_ms": p.get("deadline_ms")})
            if self.on_server_shutdown is not None:
                await self.on_server_shutdown()
            return False

        if kind == "speech_started":
            self._m = TurnMetrics(speech_started_ms=now)
            await self.on_speech_started()
            return False

        if kind == "speech_ended":
            self._m.speech_ended_ms = now
            return False

        # Leading space, and a leading period after a mid-sentence split, are artifacts.
        # Trailing punctuation is part of the transcript, so keep it.
        transcript = (p.get("transcript") or "").lstrip(" .").rstrip()

        if p.get("is_final"):
            # Empty finals are normal: a redundant finalize, or shutdown with
            # nothing pending. Never treat one as a failed turn.
            if not transcript:
                self._m.empty_finals += 1
                return bool(p.get("is_last"))

            log.info(
                "stt.final",
                extra={
                    "session_id": p.get("session_id"),
                    "is_last": bool(p.get("is_last")),
                    "time_to_first_partial_ms": (
                        self._m.first_partial_ms - self._m.speech_started_ms
                        if self._m.first_partial_ms is not None and self._m.speech_started_ms is not None
                        else None
                    ),
                    "speech_ended_to_final_ms": (
                        now - self._m.speech_ended_ms if self._m.speech_ended_ms is not None else None
                    ),
                    "from_finalize": bool(p.get("from_finalize")),
                    "finalize_to_final_ms": (
                        now - self._m.finalize_sent_ms if self._m.finalize_sent_ms is not None else None
                    ),
                    "empty_finals": self._m.empty_finals,
                },
            )
            # Commit on is_last too: a short last utterance arrives only there.
            await self.on_final_commit(transcript)
            self._m = TurnMetrics()
            return bool(p.get("is_last"))

        if transcript and self._m.first_partial_ms is None:
            self._m.first_partial_ms = now
        return False
