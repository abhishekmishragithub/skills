/**
 * Smallest AI streaming STT from a browser.
 *
 * Generated by the `voice-agent-stt` skill.
 *
 * A browser cannot set request headers on a WebSocket, so the credential goes in
 * the `api_key` query parameter. It must be a short-lived token, never the
 * permanent API key: anything in this file is visible to anyone who opens
 * developer tools. Mint the token on your backend with `token-mint.ts` (or the
 * Python equivalent) and expose it at TOKEN_ENDPOINT.
 *
 * Audio: this captures microphone PCM through an AudioWorklet at the rate the
 * AudioContext was opened with. There is no resampling here, so SAMPLE_RATE and
 * the AudioContext rate must agree with the `sample_rate` on the URL. If a
 * device refuses the requested rate, read ctx.sampleRate back and resample, or
 * the transcript comes back garbled with no error.
 *
 * Keep the worklet, not a ScriptProcessor: a stalled main thread drops audio,
 * and dropped audio at the start of a word is the most common cause of short
 * replies being missed.
 */

const HOST = "{{host}}"; // api.smallest.ai, api.us.smallest.ai, or api.india.smallest.ai
const TOKEN_ENDPOINT = "/api/stt-token"; // your backend, from token-mint.*
const SAMPLE_RATE = {{sample_rate}};
/** 20 ms per frame, which is the low end of the 20 to 40 ms the endpoint expects. */
const CHUNK_SAMPLES = Math.round(SAMPLE_RATE * 0.02);

const STT_PARAMS: Record<string, string> = {
  model: "pulse",
  language: "{{language}}",
  sample_rate: String(SAMPLE_RATE),
  encoding: "linear16",
  format: "true",
  punctuate: "true",
  capitalize: "true",
  itn_normalize: "{{itn_normalize}}",
  endpointing: "true",
  finalize_on_words: "false",
  vad_events: "true",
};
const KEYWORDS = "{{keywords}}";

export interface SttHandlers {
  onSpeechStarted: () => void;          // stop TTS playback (barge-in)
  onFinalCommit: (text: string) => void; // send to your agent
  onPartial?: (text: string) => void;    // live caption only, never commit this
  onError?: (payload: unknown) => void;
  /** Server is draining for a deploy. Finish the turn, then open a new session.
   *  Reconnection is yours to implement: this client does not retry. */
  onServerShutdown?: () => void;
  /** Your own call or conversation id, for correlating usage records. */
  externalSessionId?: string;
}

const WORKLET = `
class PcmTap extends AudioWorkletProcessor {
  process(inputs) {
    const ch = inputs[0][0];
    if (ch) this.port.postMessage(ch.slice(0));
    return true;
  }
}
registerProcessor('pcm-tap', PcmTap);
`;

export class BrowserStt {
  private ws: WebSocket | null = null;
  private ctx: AudioContext | null = null;
  private stream: MediaStream | null = null;
  private keepalive: number | null = null;
  /** Resolves when the server sends the terminal is_last message. */
  private lastSeen: (() => void) | null = null;

  constructor(private handlers: SttHandlers) {}

  private async fetchToken(): Promise<string> {
    const res = await fetch(TOKEN_ENDPOINT, { method: "POST", credentials: "same-origin" });
    if (!res.ok) throw new Error(`token endpoint returned ${res.status}`);
    const { access_token } = await res.json();
    if (!access_token) throw new Error("token endpoint returned no access_token");
    return access_token;
  }

  async start(): Promise<void> {
    const params = new URLSearchParams({ ...STT_PARAMS, api_key: await this.fetchToken() });
    if (KEYWORDS) params.set("keywords", KEYWORDS);
    if (this.handlers.externalSessionId) params.set("external_session_id", this.handlers.externalSessionId);

    // Do not pass the credential as a subprotocol. That returns 401.
    this.ws = new WebSocket(`wss://${HOST}/waves/v1/stt/live?${params}`);
    this.ws.binaryType = "arraybuffer";

    await new Promise<void>((resolve, reject) => {
      this.ws!.addEventListener("open", () => resolve(), { once: true });
      this.ws!.addEventListener("error", () => reject(new Error("WebSocket failed to open")), { once: true });
    });

    this.ws.addEventListener("message", (e) => {
      let p: any;
      try { p = JSON.parse(String(e.data)); } catch { return; }

      // Errors arrive after a successful upgrade, not as an HTTP status.
      if (p.type === "error" || p.status === "error") { this.handlers.onError?.(p); return; }
      if (p.type === "pong") return;
      // Sent about a minute before a deploy closes this socket with code 1012.
      if (p.type === "server_shutdown") { this.handlers.onServerShutdown?.(); return; }
      if (p.type === "speech_started") { this.handlers.onSpeechStarted(); return; }
      if (p.type === "speech_ended") return;

      const text: string = (p.transcript ?? "").replace(/^[.\s]+/, "").trim();
      if (p.is_final) {
        // Empty finals are normal. Commit on is_last too: a short last utterance
        // arrives only there.
        if (text) this.handlers.onFinalCommit(text);
        if (p.is_last) { this.lastSeen?.(); this.lastSeen = null; }
      } else if (text) {
        this.handlers.onPartial?.(text);
      }
    });

    this.keepalive = window.setInterval(() => {
      if (this.ws?.readyState === WebSocket.OPEN) this.ws.send(JSON.stringify({ type: "ping" }));
    }, 20_000);

    await this.startMic();
  }

  private async startMic(): Promise<void> {
    // Leave echoCancellation and noiseSuppression on for a speakerphone agent,
    // but if short replies come back wrong, test with them off first: aggressive
    // onset processing clips the first phoneme.
    this.stream = await navigator.mediaDevices.getUserMedia({
      audio: { channelCount: 1, echoCancellation: true, noiseSuppression: true },
    });
    this.ctx = new AudioContext({ sampleRate: SAMPLE_RATE });
    await this.ctx.audioWorklet.addModule(
      URL.createObjectURL(new Blob([WORKLET], { type: "application/javascript" })),
    );
    const src = this.ctx.createMediaStreamSource(this.stream);
    const node = new AudioWorkletNode(this.ctx, "pcm-tap");

    // A worklet hands over 128 samples at a time, 8 ms at 16 kHz. Accumulate to
    // CHUNK_SAMPLES before sending: the endpoint expects 20 to 40 ms frames, and
    // one socket write per 8 ms is wasted syscalls for no latency gain.
    let pending = new Int16Array(CHUNK_SAMPLES);
    let filled = 0;

    node.port.onmessage = (e) => {
      if (this.ws?.readyState !== WebSocket.OPEN) return;
      const f32 = e.data as Float32Array;
      for (let i = 0; i < f32.length; i++) {
        const s = Math.max(-1, Math.min(1, f32[i]));
        pending[filled++] = s < 0 ? s * 0x8000 : s * 0x7fff;
        if (filled === CHUNK_SAMPLES) {
          this.ws.send(pending.buffer); // binary PCM, never base64
          pending = new Int16Array(CHUNK_SAMPLES);
          filled = 0;
        }
      }
    };
    src.connect(node);
  }

  /** Once per turn, only when you are certain the user is done. */
  finalize(): void {
    if (this.ws?.readyState === WebSocket.OPEN) this.ws.send(JSON.stringify({ type: "finalize" }));
  }

  async stop(): Promise<void> {
    if (this.keepalive) window.clearInterval(this.keepalive);
    if (this.ws?.readyState === WebSocket.OPEN) {
      // Wait for the is_last message, not for the socket to close: the last
      // utterance can arrive on it. The close event and the timeout are only
      // fallbacks for a server that goes away without sending one.
      const terminal = new Promise<void>((resolve) => {
        this.lastSeen = resolve;
        this.ws!.addEventListener("close", () => resolve(), { once: true });
        setTimeout(resolve, 5000);
      });
      this.ws.send(JSON.stringify({ type: "close_stream" }));
      await terminal;
      this.lastSeen = null;
    }
    this.ws?.close();
    this.stream?.getTracks().forEach((t) => t.stop());
    await this.ctx?.close();
    this.ws = null; this.ctx = null; this.stream = null;
  }
}
