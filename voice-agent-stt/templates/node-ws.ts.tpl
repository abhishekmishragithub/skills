/**
 * Smallest AI streaming STT client.
 *
 * Generated by the `smallest-stt` skill. Turn rules, and why each one is here:
 *   - Commit on any is_final carrying text, including is_last. When the stream is
 *     closed with speech still buffered, the last utterance arrives on is_last.
 *   - Ignore is_final messages with an empty transcript. They are normal.
 *   - speechStarted stops TTS (barge-in) and nothing else.
 *   - finalize is edge-triggered, once per turn, and only after at least 300 ms of
 *     audio has been streamed past the end of speech.
 *
 * Requires: npm i ws   (ws 8 or newer, for the `headers` option on the constructor)
 */

import WebSocket from "ws";

const HOST = "{{host}}"; // api.smallest.ai, api.us.smallest.ai, or api.india.smallest.ai
const STT_URL = `wss://${HOST}/waves/v1/stt/live`;
const API_KEY_ENV = "SMALLEST_API_KEY";

const STT_PARAMS: Record<string, string> = {
  model: "pulse",
  language: "{{language}}",
  sample_rate: "{{sample_rate}}",
  encoding: "{{encoding}}",
  format: "true",
  punctuate: "true",
  capitalize: "true",
  itn_normalize: "{{itn_normalize}}",
  endpointing: "true",
  finalize_on_words: "false",
  vad_events: "true",
  // eou_timeout_ms is deliberately not set. Lowering it does not commit turns
  // faster, and below 500 the server finalizes mid-word.
};
const KEYWORDS = "{{keywords}}";

/** finalize() holds the request back this long so audio keeps flowing past the
 *  end of speech. Finalizing the instant a VAD fires truncates the last word. */
const FINALIZE_TRAILING_MS = 300;
const KEEPALIVE_IDLE_MS = 20_000;

export interface SttHandlers {
  /** Stop TTS playback. Does not commit the turn. */
  onSpeechStarted: () => void | Promise<void>;
  /** Send this to the LLM. Fires once per turn. */
  onFinalCommit: (transcript: string) => void | Promise<void>;
  onError?: (payload: unknown) => void;
  /** Server is draining for a deploy. Finish the turn, then reconnect. */
  onServerShutdown?: () => void;
  /** Your own call id, for correlating support requests. */
  externalSessionId?: string;
}

export class SttSession {
  private ws: WebSocket | null = null;
  private startedAt = Date.now();
  private lastAudioMs = 0;
  private finalizeSentMs: number | null = null;
  private speechStartedMs: number | null = null;
  private speechEndedMs: number | null = null;
  private firstPartialMs: number | null = null;
  private keepalive: NodeJS.Timeout | null = null;
  emptyFinals = 0;

  constructor(private handlers: SttHandlers) {}

  private now(): number {
    return Date.now() - this.startedAt;
  }

  async connect(): Promise<void> {
    const apiKey = process.env[API_KEY_ENV];
    if (!apiKey) throw new Error(`${API_KEY_ENV} is not set`);

    const params = { ...STT_PARAMS };
    if (KEYWORDS) params.keywords = KEYWORDS;
    if (this.handlers.externalSessionId) params.external_session_id = this.handlers.externalSessionId;

    this.ws = new WebSocket(`${STT_URL}?${new URLSearchParams(params)}`, {
      maxPayload: 10 * 1024 * 1024,
      headers: { Authorization: `Bearer ${apiKey}` },
    });

    await new Promise<void>((resolve, reject) => {
      this.ws!.once("open", resolve);
      this.ws!.once("error", reject);
    });

    this.ws.on("message", (data, isBinary) => {
      if (isBinary) return;
      try {
        void this.handle(JSON.parse(data.toString()));
      } catch {
        /* not JSON */
      }
    });

    this.keepalive = setInterval(() => {
      if (this.ws?.readyState === WebSocket.OPEN && this.now() - this.lastAudioMs > KEEPALIVE_IDLE_MS) {
        this.ws.send(JSON.stringify({ type: "ping" }));
      }
    }, KEEPALIVE_IDLE_MS);
  }

  /** Send one 20 to 40 ms chunk of raw PCM. No base64. */
  sendAudio(pcm: Buffer): void {
    if (this.ws?.readyState !== WebSocket.OPEN) return;
    this.lastAudioMs = this.now();
    this.ws.send(pcm);
  }

  /**
   * Call once per turn, the moment your own VAD or dialog logic is certain the
   * caller is done.
   *
   * Keep calling sendAudio while this promise is pending. It deliberately waits
   * FINALIZE_TRAILING_MS before sending, because finalizing with less than about
   * 300 ms of audio past the end of speech truncates the last word.
   */
  async finalize(): Promise<void> {
    if (this.ws?.readyState !== WebSocket.OPEN) return;
    const requestedAt = this.now();
    await new Promise((r) => setTimeout(r, FINALIZE_TRAILING_MS));
    if (this.ws?.readyState !== WebSocket.OPEN) return;
    if (this.lastAudioMs <= requestedAt) {
      // No audio arrived during the window, so the buffer may still be short of
      // the last word. Keep streaming through your VAD stop.
      console.warn("stt.finalize_without_trailing_audio", { silentMs: this.now() - this.lastAudioMs });
    }
    this.finalizeSentMs = this.now();
    this.ws.send(JSON.stringify({ type: "finalize" }));
  }

  /** Ask the server to flush, then wait for is_last before dropping the socket. */
  async close(timeoutMs = 5000): Promise<void> {
    if (this.ws?.readyState !== WebSocket.OPEN) return;
    const done = new Promise<void>((resolve) => {
      this.ws!.once("close", () => resolve());
      setTimeout(resolve, timeoutMs);
    });
    this.ws.send(JSON.stringify({ type: "close_stream" }));
    await done;
    if (this.keepalive) clearInterval(this.keepalive);
    this.ws?.close();
    this.ws = null;
  }

  private async handle(p: any): Promise<void> {
    const now = this.now();

    // Errors arrive after a successful upgrade, not as an HTTP status.
    if (p.type === "error" || p.status === "error") {
      this.handlers.onError?.(p);
      console.error("stt.error", p);
      return;
    }
    if (p.type === "pong") return;

    // Sent about a minute before a deploy closes this socket with code 1012.
    // Carries status "info", not an error, so it needs its own branch.
    if (p.type === "server_shutdown") {
      console.warn("stt.server_shutdown", { deadlineMs: p.deadline_ms });
      this.handlers.onServerShutdown?.();
      return;
    }

    if (p.type === "speech_started") {
      this.speechStartedMs = now;
      this.firstPartialMs = null;
      await this.handlers.onSpeechStarted();
      return;
    }
    if (p.type === "speech_ended") { this.speechEndedMs = now; return; }

    const transcript: string = (p.transcript ?? "").trim().replace(/^[.\s]+|\s+$/g, "");

    if (p.is_final) {
      // Empty finals are normal: a redundant finalize, or shutdown with nothing
      // pending. Never treat one as a failed turn.
      if (!transcript) {
        this.emptyFinals += 1;
        if (p.is_last) this.ws?.close();
        return;
      }
      console.info("stt.final", {
        sessionId: p.session_id,
        isLast: Boolean(p.is_last),
        timeToFirstPartialMs:
          this.firstPartialMs !== null && this.speechStartedMs !== null
            ? this.firstPartialMs - this.speechStartedMs
            : null,
        speechEndedToFinalMs: this.speechEndedMs !== null ? now - this.speechEndedMs : null,
        fromFinalize: Boolean(p.from_finalize),
        finalizeToFinalMs: this.finalizeSentMs !== null ? now - this.finalizeSentMs : null,
        emptyFinals: this.emptyFinals,
      });
      // Commit on is_last too: a short last utterance arrives only there.
      await this.handlers.onFinalCommit(transcript);
      this.finalizeSentMs = null;
      this.speechStartedMs = null;
      this.speechEndedMs = null;
      this.firstPartialMs = null;
      if (p.is_last) this.ws?.close();
      return;
    }

    if (transcript && this.firstPartialMs === null) this.firstPartialMs = now;
  }
}
